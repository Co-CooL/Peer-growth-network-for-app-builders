{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A founding member signup lead captured on the landing page",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The subscriber email address",
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "description": "Where on the page the lead converted",
          "maxLength": 64
        },
        "tier": {
          "type": "string",
          "description": "The pricing tier clicked, if any",
          "maxLength": 64
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "status": {
          "type": "string",
          "description": "Status of the founding invite",
          "enum": ["pending_invite", "invited", "active"],
          "maxLength": 32
        }
      },
      "required": ["email", "source"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of pre-launch founding leads and tier reservations"
    }
  }
}
